{
  "name": "agentic-sounds",
  "displayName": "Agentic Sounds",
  "description": "Alertas y notificaciones sonoras en tiempo real para agentes de IA",
  "version": "1.0.0",
  "publisher": "emeorg",
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravityAlert.testSound",
        "title": "Agentic Sounds: Probar Sonido de Notificación"
      },
      {
        "command": "antigravityAlert.status",
        "title": "Agentic Sounds: Estado del Monitor"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emeorg/agentic-sounds.git"
  },
  "scripts": {
    "clean": "rm -rf ./dist/*",
    "build": "bun build ./src/extension.ts --outfile=./dist/extension.js --target=node --format=cjs --external=vscode",
    "package": "bun run clean && bun run build && vsce package --no-dependencies --allow-missing-repository --allow-star-activation"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
}
